{
  "multipart": [
    { "when": { "axis": "z" }, "apply": { "model": "kinetics:block/girder_beam_x" } },
    { "when": { "axis": "x" }, "apply": { "model": "kinetics:block/girder_beam_z" } },
    { "when": { "top": "true" }, "apply": { "model": "kinetics:block/girder_post_top" } },
    { "when": { "bottom": "true" }, "apply": { "model": "kinetics:block/girder_post_bottom" } }
  ]
}
